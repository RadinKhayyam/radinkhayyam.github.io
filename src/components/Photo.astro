---
import images from '../data/images.json';
interface Props { name: keyof typeof images; alt: string; eager?: boolean; class?: string; sizes?: string; }
const { name, alt, eager = false, class: className, sizes = '(max-width: 760px) 100vw, 45vw' } = Astro.props;
const photo = images[name];
---
<img {...photo} alt={alt} sizes={sizes} class={className} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
