---
import { contacts, site } from '../data/site';
---

<footer class="site-foot">
  <div class="container foot-row">
    <p>{site.name}, {site.location}</p>
    <ul>
      {
        contacts.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
