---
import { network } from '../data/network';

const byId = new Map(network.nodes.map((node) => [node.id, node]));
---

<div class="field" data-neural data-network={JSON.stringify(network)}>
  <svg class="field-static" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {
      network.edges.map((edge) => {
        const from = byId.get(edge.from);
        const to = byId.get(edge.to);
        if (!from || !to) return null;
        return (
          <line
            x1={from.x * 100}
            y1={from.y * 100}
            x2={to.x * 100}
            y2={to.y * 100}
          />
        );
      })
    }
    {network.nodes.map((node) => <circle cx={node.x * 100} cy={node.y * 100} r="0.7" />)}
  </svg>
  <canvas aria-hidden="true"></canvas>
</div>

<script>
  import { mountNeural } from '../scripts/neural';

  document.querySelectorAll<HTMLElement>('[data-neural]').forEach((root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    mountNeural(root);
  });
</script>
