---
import Base from '../layouts/Base.astro';
import Race from '../components/Race.astro';
import Photo from '../components/Photo.astro';
import Pipeline from '../components/Pipeline.astro';
import SocialLinks from '../components/SocialLinks.astro';
import copy from '../data/copy.json';
import { site } from '../data/site';
import { markdown } from '../lib/markdown';
const photos = [
  ['2018-taipei-gold-podium','Radin on the gold-medal podium in Chinese Taipei, 2018.'],
  ['2025-sharif-graduation','Radin at his Sharif University of Technology graduation.'],
  null,
  ['2025-olympia-presenting','Radin presenting in Olympia at the Young Olympic Ambassadors session.'],
  null,
  ['2026-koc-campus','Koç University campus.'],
] as const;
const sharif = copy.chapters[1].body.split(/\n\s*\n/);
const work = copy.work.split('\n\n').slice(0,3);
---
<Base page="home">
  <section class="hero" aria-labelledby="hero-title">
    <canvas id="hero-backdrop" aria-hidden="true"></canvas>
    <div class="container hero-grid">
      <div class="hero-copy"><h1 id="hero-title">Radin Khayyam</h1>
        <p class="lead">{copy.hero[0].replaceAll('**','')}</p>
        <p class="why">{copy.hero[1].replaceAll('*','')}</p>
        <div class="hero-actions"><a class="btn" href="/research/">Research</a><a class="btn ghost" href={site.cv} download>Download CV</a></div>
        <a class="contact-link" href="#contact">Get in touch</a>
      </div>
      <Race />
    </div>
  </section>
  <section class="container section about" id="about" aria-labelledby="about-heading">
    <div class="glass portrait"><Photo name="casual" alt="Radin sitting on wooden steps at night, smiling." sizes="(max-width: 760px) min(calc(100vw - 68px), 380px), (max-width: 1250px) min(calc(50vw - 88px), 500px), 500px" /></div>
    <div><h2 id="about-heading">About</h2><p class="about-copy">{copy.about}</p></div>
  </section>
  <section class="container section story" aria-labelledby="story-heading">
    <h2 id="story-heading">My story so far</h2>
    <div class="timeline-shell">
    <div class="timeline-current" aria-hidden="true"><div class="sticky-years"><span></span><span></span></div></div>
    <ol class="timeline">
      {copy.chapters.map((chapter,i) => <li class:list={['timeline-row',i % 2 === 1 && 'reverse']}>
        <div class="chapter-date"><p>{chapter.date}</p></div>
        <span class="timeline-pin" aria-hidden="true"></span>
        <article class:list={["glass chapter-card", i === 5 && "chapter-card-portrait"]}>
          {photos[i] && <div class="chapter-photo"><div class="photo-frame"><Photo name={photos[i]![0]} alt={photos[i]![1]} /></div></div>}
          {i === 2 && <div class="university-logos">{[['rice','Rice University'],['usc','USC'],['umd','University of Maryland'],['ucr','UC Riverside']].map(([file,name]) => <div><img src={`/logos/${file}.svg`} alt={name} width="200" height="80" loading="lazy" /></div>)}</div>}
          {i === 4 && <Pipeline />}
          <div class="chapter-body"><h3>{chapter.title}</h3>
            {i === 1 ? <>
              <p>{sharif[0]}</p>
              <aside class="hong-kong" data-reveal>
                <span class="sub-pin" aria-hidden="true"></span>
                <Photo name="2023-cuhk-faculty-of-science" alt="Radin at the CUHK Faculty of Science in Hong Kong." sizes="(max-width: 760px) 80vw, (max-width: 1250px) 40vw, 471px" />
                <div class="prose" set:html={markdown(sharif[1])} />
              </aside>
              <p>{sharif[2]}</p>
            </> : <div class="prose" set:html={markdown(chapter.body.split('\nLink:')[0])} />}
            {i === 0 && <a class="text-link" href="/sport/">The full story is on the Sport page →</a>}
          </div>
        </article>
      </li>)}
    </ol>
    </div>
  </section>
  <section class="container section work" aria-labelledby="work-heading">
    <h2 id="work-heading">What I work on</h2>
    <div class="work-rows">{work.map(text => <div class="work-row" set:html={markdown(text)} />)}</div>
    <a class="text-link" href="/research/">Read about my research →</a>
  </section>
  <section class="container teasers">
    <article class="glass teaser"><h2>Experience &amp; Projects.</h2><p>Industry, teaching and projects.</p><a class="text-link" href="/experience/">See experience &amp; projects →</a></article>
    <article class="glass teaser"><h2>Sport.</h2><p>Table tennis for most of my life, and running these days.</p><a class="text-link" href="/sport/">See the sport page →</a></article>
  </section>
  <section class="container section contact" id="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact</h2>
    <p>{copy.contact}</p><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
    <SocialLinks />
  </section>
</Base>
