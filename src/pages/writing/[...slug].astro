---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const format = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="page-head">
      <h1>{post.data.title}</h1>
      <time class="byline" datetime={post.data.date.toISOString()}>{format.format(post.data.date)}</time>
    </header>
    {
      post.data.placeholder && (
        <p class="note" role="note">
          Placeholder. This file is <code>src/content/writing/welcome.md</code>. Delete it when a real note replaces it.
        </p>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
