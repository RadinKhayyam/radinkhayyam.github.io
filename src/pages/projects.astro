---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const repos = [
  {
    title: 'Deep Learning',
    href: 'https://github.com/RadinKhayyam/Deep_Learning_Course',
    when: 'Fall 2024',
    meta: 'Instructor: Prof. Emad Fatemizadeh',
    text: 'Designed CNN models in PyTorch for CIFAR-10, fine-tuned MobileNetV2 on Oxford 102 Flowers, built an RNN for tweet emotion detection, and completed multi-sport player tracking.',
  },
  {
    title: 'Lightweight LLMs for Persian news title generation',
    href: 'https://github.com/RadinKhayyam/Persian-News-Title-Generation',
    when: '',
    meta: '',
    text: 'Evaluated Gemma 3 4B and Llama 3.1 8B on 1,000+ editor-written Persian news content and title pairs, comparing zero-shot, few-shot, and refined prompting against LoRA fine-tuning using BLEU, ROUGE-L, METEOR, and BERTScore, plus a qualitative review.',
  },
  {
    title: 'Introduction to Machine Learning',
    href: 'https://github.com/RadinKhayyam/Introduction_to_Machine_Learning_Course',
    when: 'Spring 2024',
    meta: 'Instructor: Prof. Mohammad Shamsollahi',
    text: 'Implemented a supervised classifier in Python for loan-eligibility prediction from financial and demographic features.',
  },
  {
    title: 'EEG Signal Processing',
    href: 'https://github.com/RadinKhayyam/EEG_Signal_Processing_Course',
    when: 'Fall 2023',
    meta: 'Instructor: Prof. Sepideh Hajipour',
    text: 'Implemented source localization (MNE, WMNE, LORETA, sLORETA), blind source separation (PCA, ICA, DSS, GEVD), SSVEP CCA and P300 detection, and CSP with an SVM for motor-imagery classification.',
  },
  {
    title: 'Neuroscience of Learning, Memory, and Cognition',
    href: 'https://github.com/RadinKhayyam/Neuroscience_of_Learning_Memory_and_Cognition_Course',
    when: 'Spring 2024',
    meta: 'Instructor: Prof. Hamid Aghajan',
    text: 'Applied PLV, PLI, and PAC on rat LFP, and fine-tuned AlexNet on BOLD responses from LOC. Implemented a Deep Q-Network agent in a maze that learned a policy from rewards.',
  },
];
---

<Base
  title="Projects"
  description="Applied machine learning and language-model systems by Radin Khayyam, including work at Solico Group and selected projects from the academic CV."
>
  <header class="page-head">
    <h1>Projects</h1>
    <p class="lede">
      Applied machine learning and language-model systems, the applications track. Solico Group is the job. The
      repositories below are selected projects from the CV.
    </p>
  </header>

  <section class="block">
    <h2>Solico Group</h2>
    <p>
      AI engineer, full time, from August 2025 to September 2026.
      <a href={site.solico}>solico-group.com</a>
    </p>
    <ul class="plain">
      <li>
        Led the R&amp;D and implementation of a B2B order-suggestion platform for FMCG customers, building working demos
        for recommendation, customer targeting, and quantity estimation, and evaluating the models offline.
      </li>
      <li>
        Built a medallion-architecture data pipeline to preprocess transaction-database data daily into inputs for the
        platform.
      </li>
      <li>
        Built a three-stage recommender: a two-tower retriever trained with contrastive learning to learn customer,
        product, and categorical-feature embeddings; a LightGBM learning-to-rank model using historical features; and
        rule-based reranking for stock availability and promoted products.
      </li>
      <li>
        Used feature overrides for cold-start and what-if recommendations, and developed customer targeting to identify
        likely buyers of newly launched or previously unpurchased products.
      </li>
      <li>
        Developed a quantity estimator that suggests units when a product is added to a basket, aiming to reduce
        overstocking, understocking, and expired-product returns.
      </li>
      <li>
        Contributed to a shopping-assistant chatbot using web-scraped product data and retrieval-augmented generation.
        Applied domain adaptation and instruction tuning to Gemma 3 4B with LoRA, for product discovery and basket
        management.
      </li>
    </ul>
  </section>

  <section class="block">
    <h2>Selected repositories</h2>
    <div class="repos">
      {
        repos.map((repo) => (
          <article class="repo">
            <div>
              <h3>
                <a href={repo.href}>{repo.title}</a>
              </h3>
              {repo.meta && <p>{repo.meta}</p>}
              <p>{repo.text}</p>
            </div>
            {repo.when && <p class="when">{repo.when}</p>}
          </article>
        ))
      }
    </div>
  </section>
</Base>
