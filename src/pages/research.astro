---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { markdown } from '../lib/markdown';
import { research } from '../data/copy.json';
const applied = research.applied.split('\n\n');
---
<Base title="Research" page="research">
  <div class="container page-intro research-intro">
    <div><h1>Research</h1><p class="lead">{research.intro}</p></div>
    <Photo name="2026-koc-campus" alt="Koç University campus." eager />
  </div>
  <section class="container section research-track" aria-labelledby="theory-heading">
    <div class="section-heading"><span class="label">Track 1 (main focus)</span><h2 id="theory-heading">Theory of learning</h2></div>
    <div class="glass reading-panel prose" set:html={markdown(research.theory)} />
  </section>
  <section class="container section" aria-labelledby="applied-heading">
    <div class="section-heading"><span class="label">Track 2</span><h2 id="applied-heading">Applied AI</h2></div>
    <p class="section-intro">{applied[0]}</p>
    <div class="applied-grid">{applied.slice(1).map(part => <article class="glass reading-panel prose" set:html={markdown(part)} />)}</div>
  </section>
  <section class="container section" aria-labelledby="research-experience"><h2 id="research-experience">Research experience</h2>
    <div class="entries">{research.experience.map((entry,i) => <article class="entry">
      <div class="entry-heading"><h3>{entry.title}</h3><p class="label">{entry.meta}</p></div>
      <div><div class="prose" set:html={markdown(entry.body.replace('\n','\n\n'))} />{i === 2 && <Photo name="2023-cuhk-campus" alt="The Chinese University of Hong Kong campus." class="entry-photo" />}</div>
    </article>)}</div>
  </section>
  <section class="container section publications" aria-labelledby="publications-heading"><h2 id="publications-heading">Publications</h2><div class="glass reading-panel prose" set:html={markdown(research.publications)} /></section>
</Base>
