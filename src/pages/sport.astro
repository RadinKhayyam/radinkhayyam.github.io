---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { markdown } from '../lib/markdown';
import { sport } from '../data/copy.json';
const photos = [
  ['2017-slovenia-cadet-podium','Radin on the cadet singles podium in Slovenia, 2017.'],
  ['2018-jordan-action','Radin competing in Jordan, 2018.'],
  ['2018-tottori-wcc-asian-silver-podium','The Asian team on the silver-medal podium at the World Cadet Challenge, Tottori.'],
  ['2022-sulaymaniyah-world-tournament','Radin at the world tournament in Sulaymaniyah, 2022.'],
] as const;
const running = sport.running.split('\n\n');
const runs=running[1].split('\n').map(s=>s.replace(/^- /,''));
---
<Base title="Sport" page="sport">
  <section class="sport-chapter sport-opening" aria-labelledby="sport-heading">
    <Photo name="2018-taipei-action-iran-shirt" alt="Radin playing table tennis for Iran in Chinese Taipei, 2018." eager class="sport-background" sizes="100vw" />
    <div class="sport-scrim"></div>
    <div class="container sport-opening-content"><div class="sport-copy"><h1 id="sport-heading">Table tennis</h1><p>{sport.intro}</p><a class="text-link" href="#table-tennis">Table tennis</a><a class="text-link" href="#running">Running</a></div></div>
  </section>
  <section class="container section sport-history" id="table-tennis" aria-labelledby="sport-heading">
    {sport.chapters.map((chapter,i) => <article class="sport-history-row">
      <div><h3>{chapter.title}</h3><div class="prose" set:html={markdown(chapter.body)} /></div>
      <Photo name={photos[i][0]} alt={photos[i][1]} />
    </article>)}
  </section>
  <section class="container section honors" aria-labelledby="honors-heading"><h2 id="honors-heading">Selected honors</h2><div class="honors-table" set:html={markdown(sport.honors)} /></section>
  <section class="sport-chapter running-opening" id="running" aria-labelledby="running-heading">
    <div class="running-backdrop" aria-hidden="true"></div>
    <div class="container running-grid"><div class="sport-copy"><h2 id="running-heading">Running</h2><p>{running[0]}</p></div>
      <figure class="glass running-portrait"><Photo name="2025-kish-marathon" alt="Radin at the Kish Island International Marathon, December 2025." /><figcaption>6th Kish Island International Marathon</figcaption></figure>
    </div>
  </section>
  <section class="container section running-results" aria-labelledby="running-heading">
    <div class="running-cards">
      <article><Photo name="2025-olympia-day-run" alt="Radin at the Olympic Day Run in Olympia, Greece." /><div class="prose" set:html={markdown(runs[0])} /></article>
      <article><Photo name="2025-tehrun-10k" alt="Radin at the 2nd TehRun 10K in Tehran." /><div class="prose" set:html={markdown(runs[1])} /></article>
      <article class="running-text"><div class="prose" set:html={markdown(runs[2])} /></article>
      <article class="running-text"><div class="prose" set:html={markdown(runs[3])} /></article>
    </div>
  </section>

</Base>
